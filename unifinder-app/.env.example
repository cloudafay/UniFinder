# UniFinder Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Supabase Configuration
# Supabase Dashboard > Settings > API'den alınabilir
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Push Notifications (Expo)
# EXPO_PUBLIC_PUSH_TOKEN=your-expo-push-token

# Optional: Analytics
# EXPO_PUBLIC_ANALYTICS_KEY=your-analytics-key
