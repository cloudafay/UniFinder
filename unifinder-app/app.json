{
  "expo": {
    "name": "UniFinder",
    "slug": "unifinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "unifinder",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1337ec"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unifinder.app",
      "infoPlist": {
        "NSCameraUsageDescription": "UniFinder needs camera access to take profile photos.",
        "NSPhotoLibraryUsageDescription": "UniFinder needs photo library access to select profile photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1337ec"
      },
      "package": "com.unifinder.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "UniFinder needs access to your photos to set your profile picture.",
          "cameraPermission": "UniFinder needs access to your camera to take profile photos."
        }
      ],
      "expo-asset"
    ]
  }
}
